# Optional external public form URLs. Leave empty to use the server's Baserow forms.
# Without configured Baserow form tables, the site falls back to email drafts.
VITE_CONTACT_ENDPOINT=
VITE_SIGNUP_ENDPOINT=
VITE_EBOOK_ENDPOINT=
# Public HTTP endpoint for both forms; receives type=contact or type=newsletter.
# Use an HTTPS URL with browser CORS enabled. Never put API keys here.
VITE_WEBHOOK_URL=
# Optional exact brand artwork after uploading the original file into public/images.
# Example: /images/hdx-logo.png. Leave blank until the original file is available.
VITE_BRAND_LOGO_URL=

# Server-only Baserow credentials. Never prefix the token with VITE_.
BASEROW_API_URL=https://api.baserow.io
BASEROW_TABLE_ID=1258474
BASEROW_TOKEN=
# Separate form tables, not the Products table. Token needs Read + Create on both.
BASEROW_CONTACT_TABLE_ID=
BASEROW_NEWSLETTER_TABLE_ID=
BASEROW_EBOOK_REQUEST_TABLE_ID=

# HeDi chat: server-only OpenAI key, not the Baserow Database Token.
HEDI_OPENAI_API_KEY=
HEDI_OPENAI_MODEL=gpt-4.1-mini

# Hybrid setup: Baserow edits products and owns ebook/newsletter subscribers.
# Activate only after running supabase/migrations/202610120001_hedoix.sql.
# Defaults remain baserow until these provider variables are set explicitly.
CATALOG_PROVIDER=baserow
CONTACT_PROVIDER=baserow
NEWSLETTER_PROVIDER=baserow
SUPABASE_URL=https://smjzlzhbnojrdrhvnapp.supabase.co
# Server-only Secret key (sb_secret_...) or legacy service_role JWT. Never VITE_.
SUPABASE_SECRET_KEY=
BASEROW_SYNC_INTERVAL_SECONDS=300

# Baserow MailQueue relays contact confirmations from Supabase through Gmail.
# The token needs Read + Create on this separate table.
# Gmail's App Password belongs only in Baserow's SMTP integration.
BASEROW_EMAIL_TABLE_ID=
